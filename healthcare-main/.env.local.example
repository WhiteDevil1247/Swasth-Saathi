# Frontend envs (Next.js)
# Copy to .env.local in this folder for local/dev
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8000/signalling
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=REPLACE_ME
# If you do NOT have a Sentry token on Vercel, keep this to skip uploads
SENTRY_SKIP_UPLOAD=1
